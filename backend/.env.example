# Copie ce fichier en ".env" et remplis au moins une clé.
# Toutes les clés ci-dessous sont gratuites, sans carte bancaire.

# Gemini : https://aistudio.google.com (qualité, mais ~20 req/jour/modèle en gratuit)
GEMINI_API_KEY=
# Cerebras : https://cloud.cerebras.ai (1M tokens/jour gratuits)
CEREBRAS_API_KEY=
# Groq : https://console.groq.com/keys (14 400 req/jour sur llama 8b)
GROQ_API_KEY=
# Mistral : https://console.mistral.ai (tier Experiment, 2 req/min)
MISTRAL_API_KEY=

# Chaîne de bascule : entrées "fournisseur/modèle" essayées dans l'ordre.
# Les fournisseurs sans clé sont sautés automatiquement au démarrage.
LLM_CHAIN=gemini/gemini-3.5-flash,gemini/gemini-3.1-flash-lite,gemini/gemini-3-flash-preview,gemini/gemini-2.5-flash,gemini/gemini-2.5-flash-lite,cerebras/gpt-oss-120b,cerebras/zai-glm-4.7,groq/llama-3.3-70b-versatile,groq/llama-3.1-8b-instant,mistral/mistral-small-latest

# ─────────────────────────────────────────────────────────────────────────────
# Ce qui décide du comportement d'une instance DÉPLOYÉE.
#
# 19/09/2026 : ces réglages existaient dans le code et nulle part ici. Le 18/09,
# `PUBLIC_ORIGIN` non posée faisait servir « localhost » dans le canonical, l'og:url,
# l'og:image et le Sitemap de robots.txt — le lien partagé restait une ligne grise, et
# rien ne le signalait. Le produit devine désormais l'adresse à défaut ; la variable
# manquait quand même là où on la lit AVANT de déployer.
#
# En local, tout ce bloc peut rester commenté : les valeurs par défaut suffisent.

# L'adresse publique du site, sans barre finale. À poser DERRIÈRE UN PROXY : c'est lui
# qui sait, et l'en-tête « Host » d'un client ne doit pas pouvoir le contredire.
# Non posée hors proxy, le produit lit l'adresse par laquelle on l'a joint.
#PUBLIC_ORIGIN=https://lumenia.exemple.fr

# « 1 » redirige toute requête en clair vers HTTPS (308). À poser quand l'hébergeur sert
# en HTTPS. Laissée vide en local : une redirection rendrait le produit intestable.
#FORCE_HTTPS=1

# « 1 » quand une instance est derrière un proxy : l'anti-spam lit alors l'adresse du
# visiteur dans « X-Forwarded-For ». Sans ça, tous les visiteurs partagent celle du
# proxy — donc le même quota, et une seule personne peut épuiser le service.
#LUMENIA_DERRIERE_PROXY=1

# Où vivent les données. Par défaut, un SQLite local dans backend/data/.
#DATABASE_URL=sqlite:///./data/lumenia.db

# ─────────────────────────────────────────────────────────────────────────────
# Réglages fins des modèles — inutiles tant que LLM_CHAIN ci-dessus suffit.

# Adresse du fournisseur compatible OpenAI, si elle doit changer.
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Un modèle unique, ou une liste, pour court-circuiter la chaîne.
#LLM_MODEL=
#LLM_MODELS=
